# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Gmail API Configuration (OAuth 2.0)
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REFRESH_TOKEN=your_refresh_token
GMAIL_ACCESS_TOKEN=your_access_token

# Database
DATABASE_URL=sqlite:///data/pitcherai.db

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# Collector Settings
CRUNCHBASE_API_KEY=your_crunchbase_api_key (optional)
ANGELLIST_TOKEN=your_angellist_token (optional)

# Email Settings
SENDER_EMAIL=your_email@gmail.com
SENDER_NAME=Your Name

# Dashboard Settings
DASHBOARD_PORT=8501
DASHBOARD_HOST=localhost
