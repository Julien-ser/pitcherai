# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# Gmail API Configuration
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token
GMAIL_ACCESS_TOKEN=your_gmail_access_token
# Note: Use OAuth2 for Gmail access. See setup instructions.

# Database Configuration
DATABASE_URL=sqlite:///pitcherai.db

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=True

# Collector Configuration
CRUNCHBASE_API_KEY=your_crunchbase_api_key
ANGELLIST_API_KEY=your_angellist_api_key
NEWS_API_KEY=your_news_api_key

# Campaign Configuration
DEFAULT_CAMPAIGN_DELAY_DAYS=7
MAX_EMAILS_PER_DAY=50
USER_EMAIL=your_email@example.com
USER_NAME=Your Name
USER_COMPANY=Your Startup
USER_DESCRIPTION=Your startup description (1-2 sentences)

# Learning Engine
ENABLE_LEARNING=True
MIN_RESPONSES_FOR_LEARNING=10
