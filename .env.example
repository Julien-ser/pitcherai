# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/pitcherai
REDIS_URL=redis://localhost:6379/0

# Gmail API (get from Google Cloud Console)
GMAIL_CLIENT_ID=your_client_id
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REFRESH_TOKEN=your_refresh_token

# LLM API (OpenRouter recommended)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# Crunchbase API (optional)
CRUNCHBASE_API_KEY=your_crunchbase_key

# AngelList API (optional)
ANGELLIST_ACCESS_TOKEN=your_angellist_token

# LinkedIn API (optional for connection finding)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# App Settings
SECRET_KEY=your-secret-key-here-change-this
DEBUG=True
APP_ENV=development

# Email Sending
MAX_EMAILS_PER_DAY=100
EMAIL_RATE_LIMIT=10  # per minute
FOLLOWUP_DAYS=7

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501
API_HOST=0.0.0.0
API_PORT=8000