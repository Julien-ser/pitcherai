[Unit]
Description=PitcherAI Web Application
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=pitcherai
Group=pitcherai
WorkingDirectory=/opt/pitcherai
Environment="PATH=/opt/pitcherai/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=/opt/pitcherai/.env
ExecStart=/opt/pitcherai/.venv/bin/uvicorn pitcherai.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
